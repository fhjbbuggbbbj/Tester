local function doAimMethod()
    local cam = getCam()
    if not cam then return end
    local score = 0
    local mb = safe(function() return UIS.MouseBehavior end)
    if mb==Enum.MouseBehavior.LockCenter then score+=60 end
    if mb==Enum.MouseBehavior.LockCurrentPosition then score+=25 end
    local subj = safe(function() return cam.CameraSubject end)
    if subj and safe(function() return subj:IsA("Humanoid") end) then score+=8 end
    if G.SCAN.activeVM then
        local h = safe(function() return G.SCAN.activeVM:FindFirstChild("Handle") end)
        if h then score+=20; G.SCAN.aimType="viewmodel" end
    end
    if G.SCAN.activeShoot then score+=10 end
    if safe(function() return cam.CameraType end)==Enum.CameraType.Scriptable then score+=15 end
    G.SCAN.aimConf = math.min(100,score)
    G.CFG.aimbotMode = G.SCAN.aimType
    log(("[AimMethod] %s conf=%d%%"):format(G.SCAN.aimType,G.SCAN.aimConf))
end

