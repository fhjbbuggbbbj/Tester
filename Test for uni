local function findTargetImpl()
    local cam = getCam()
    if not cam then return nil end
    local best, bestD = nil, G.CFG.fov
    local camCF = safe(function() return cam.CFrame end)
    if not camCF then return nil end
    local vp = cam.ViewportSize
    local cx,cy = vp.X/2, vp.Y/2

    for _,pl in ipairs(Players:GetPlayers()) do
        if pl==LP then continue end
        if G.CFG.teamCheck and safe(function() return pl.Team==LP.Team end) then continue end
        local char = safe(function() return pl.Character end)
        if not char then continue end
        local hum = safe(function() return char:FindFirstChildWhichIsA("Humanoid") end)
        if not hum or (safe(function() return hum.Health end) or 0)<=0 then continue end
        local part = safe(function() return char:FindFirstChild(G.CFG.hitPart) end)
                  or safe(function() return char:FindFirstChild("HumanoidRootPart") end)
                  or safe(function() return char:FindFirstChild("Head") end)
                  or safe(function() return char:FindFirstChild("UpperTorso") end)
                  or safe(function() return char:FindFirstChild("Torso") end)
                  or safe(function() return char:FindFirstChildWhichIsA("BasePart") end)
        if not part then continue end
        local pos = safe(function() return part.Position end)
        if not pos then continue end
        local sp, vis = cam:WorldToViewportPoint(pos)
        if not vis then continue end
        if G.CFG.wallCheck then
            local o = camCF.Position
            local dir = pos-o
            local ignore = {}
            if LPChar then ignore[#ignore+1]=LPChar end
            ignore[#ignore+1]=cam
            local ray = Ray.new(o, dir.Unit*math.min(dir.Magnitude,9999))
            local hit = safe(function() return workspace:FindPartOnRayWithIgnoreList(ray,ignore) end)
            if hit and not safe(function() return hit:IsDescendantOf(char) end) then continue end
        end
        local d = Vector2.new(sp.X-cx, sp.Y-cy).Magnitude
        if d<bestD then bestD=d; best={pl=pl,char=char,part=part,pos=pos} end
    end
    return best
end

local function findTarget()
    byp(true)
    local ok, res = pcall(findTargetImpl)
    byp(false)
    if not ok then return nil end
    return res
end

