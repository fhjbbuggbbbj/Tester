-- TRIGGERBOT
-- ============================================================
local tbotUp=false
local function startTriggerbot()
    if tbotUp then return end; tbotUp=true
    task.spawn(function()
        while true do
            task.wait(0.04)
            run(refreshMob)
            if not G.CFG.tbot or not keyHeld() then continue end
            local cam=getCam()
            if not cam then continue end
            local t=tcache.t
            local fire=false
            if t and t.part then
                local sp,vis=cam:WorldToViewportPoint(t.pos or t.part.Position)
                if vis then
                    local vp=cam.ViewportSize
                    if Vector2.new(sp.X-vp.X/2,sp.Y-vp.Y/2).Magnitude < math.max(60,G.CFG.fov*0.4) then
                        fire=true
                    end
                end
            end
            if not fire then
                local cf=safe(function() return cam.CFrame end)
                if cf then
                    local ignore={}
                    if LPChar then ignore[#ignore+1]=LPChar end
                    ignore[#ignore+1]=cam
                    local ray=Ray.new(cf.Position,cf.LookVector*2000)
                    local hit=safe(function() return workspace:FindPartOnRayWithIgnoreList(ray,ignore) end)
                    if hit then
                        local model=safe(function() return hit:FindFirstAncestorWhichIsA("Model") end)
                        if model then
                            local hum=safe(function() return model:FindFirstChildWhichIsA("Humanoid") end)
                            if hum and (safe(function() return hum.Health end) or 0)>0 then
                                local ok2=true
                                if G.CFG.teamCheck then
                                    local pl=Players:GetPlayerFromCharacter(model)
                                    if pl and safe(function() return pl.Team==LP.Team end) then ok2=false end
                                end
                                if ok2 then fire=true end
                            end
                        end
                    end
                end
            end
            if fire then task.wait(G.CFG.trigDelay); doFire() end
        end
    end)
end

