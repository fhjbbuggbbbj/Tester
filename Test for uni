local function buildMob()
    if mobGui and mobGui.Parent then applyMobStyle(); return end
    destroyMob()
    local sg=Instance.new("ScreenGui")
    sg.Name="NonoMob"; sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true; sg.DisplayOrder=999
    pcall(function() sg.Parent=game:GetService("CoreGui") end)
    if not sg.Parent then pcall(function() sg.Parent=LP:WaitForChild("PlayerGui") end) end
    if not sg.Parent then return end
    local btn=Instance.new("TextButton")
    btn.Name="Mob"; btn.BorderSizePixel=0; btn.TextColor3=Color3.new(1,1,1)
    btn.TextSize=22; btn.Font=Enum.Font.GothamBold; btn.AutoButtonColor=false; btn.Visible=false
    btn.Parent=sg
    local co=Instance.new("UICorner"); co.CornerRadius=UDim.new(1,0); co.Parent=btn
    mobConns[#mobConns+1]=btn.MouseButton1Down:Connect(function() G.TRIG_HELD=true end)
    mobConns[#mobConns+1]=btn.MouseButton1Up:Connect(function() G.TRIG_HELD=false end)
    mobConns[#mobConns+1]=btn.MouseLeave:Connect(function() G.TRIG_HELD=false end)
    local drag,dS,dP
    mobConns[#mobConns+1]=btn.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch then drag=true;dS=i.Position;dP=btn.Position end
    end)
    mobConns[#mobConns+1]=UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType==Enum.UserInputType.Touch then
            local d=i.Position-dS
            btn.Position=UDim2.new(dP.X.Scale,dP.X.Offset+d.X,dP.Y.Scale,dP.Y.Offset+d.Y)
        end
    end)
    mobConns[#mobConns+1]=UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch then drag=false end
    end)
    mobGui=sg; mobBtn=btn; applyMobStyle()
end

local function refreshMob()
    if not G.CFG.mobEnabled then if mobBtn then run(function() mobBtn.Visible=false end) end; return end
    buildMob()
    if mobBtn then run(function() mobBtn.Visible=UIS.TouchEnabled and G.CFG.tbot end) end
end

local function keyHeld()
    if G.TRIG_HELD then return true end
    if not G.CFG.trigKey then return true end
    local ok,k=pcall(function() return UIS:IsKeyDown(G.CFG.trigKeyCode) end)
    return ok and k
end

