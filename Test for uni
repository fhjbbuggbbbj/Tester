task.spawn(function() while task.wait(30) do saveConfig() end end)

_G.NONO_UNLOAD=function()
    G.ENABLED=false
    for _,c in ipairs(CONNS) do pcall(function() c:Disconnect() end) end
    for pl in pairs(espC) do killESP(pl) end
    for _,d in ipairs(DRAWS) do pcall(function() d:Remove() end) end
    if fovC then pcall(function() fovC:Remove() end) end
    uninstallGC(); destroyMob(); saveConfig()
    print("[Nono] v10 unloaded")
end

-- ============================================================
-- UI
-- ============================================================
local Library, Window
local UI={}

local function sl(lbl,txt)
    if not lbl then return end
    local s=tostring(txt)
    pcall(function() lbl.Text=s end)
    pcall(function() lbl:SetText(s) end)
    pcall(function() if lbl.Label then lbl.Label.Text=s end end)
    pcall(function() if lbl.Object then lbl.Object.Text=s end end)
    pcall(function() if lbl.Instance then lbl.Instance.Text=s end end)
    pcall(function() if lbl.TextLabel then lbl.TextLabel.Text=s end end)
end

local function refreshAllDropdowns()
    pcall(function() if UI.hitPartDrop then UI.hitPartDrop:SetValues(G.SCAN.parts) end end)
    pcall(function() if UI.shootDrop then UI.shootDrop:SetValues(G.SCAN.shootList) end end)
    pcall(function() if UI.vmDrop then UI.vmDrop:SetValues(G.SCAN.vmList) end end)
end

local function buildUI()
    print("[Nono] Loading Obsidian...")
    local ok,lib=pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/Obsidian/main/Library.lua"))()
    end)
    if not ok or type(lib)~="table" then warn("[Nono] Obsidian fail: "..tostring(lib)); return end
    Library=lib

    local okW,win=pcall(function()
        return Library:CreateWindow({
            Title="nono v10  -  "..G.SCAN.class,
            Footer="made by nono",
            AutoShow=true, Center=true, NotifySide="Right",
        })
    end)
    if not okW then warn("[Nono] Window: "..tostring(win)); return end
    Window=win

    local function tab(nm)
        local ok2,t=pcall(function() return Window:AddTab(nm) end)
        return ok2 and t or nil
    end

    local TM=tab("Main"); if not TM then return end

    local SB=TM:AddLeftGroupbox("Status")
    UI.lblStatus=SB:AddLabel("...")
    UI.lblScan=SB:AddLabel("Scan: 0%")
    UI.lblGC=SB:AddLabel("GC: -")
    UI.lblAC=SB:AddLabel("AC: ...")
    UI.lblClass=SB:AddLabel("Class: ...")
    UI.lblMove=SB:AddLabel("Move: ...")
    UI.lblArms=SB:AddLabel("Arms: ...")
    UI.lblParts=SB:AddLabel("Parts: 0")
    UI.lblVMs=SB:AddLabel("VMs: 0")
    UI.lblRems=SB:AddLabel("Remotes: 0")

    task.spawn(function()
        while task.wait(0.3) do pcall(function()
            sl(UI.lblStatus,("FPS %d  Ping %dms  Active %d"):format(G.STATS.fps,G.STATS.ping,G.STATS.active))
            sl(UI.lblScan,("Scan %d%%  GC %d%%"):format(
                math.floor(G.SCAN_STAGE/math.max(1,G.SCAN_TOTAL)*100),
                math.floor(G.GC_STAGE/math.max(1,G.GC_TOTAL)*100)))
            sl(UI.lblGC,("GC:%d hooks  Meta:%s"):format(#G.HOOKS.gc, G.HOOKS.meta and G.HOOKS.meta.via or "off"))
            sl(UI.lblAC,#G.SCAN.antiCheat>0 and ("AC x%d"):format(#G.SCAN.antiCheat) or "AC: clean")
            sl(UI.lblClass,"Class: "..G.SCAN.class)
            sl(UI.lblMove,"Move: "..G.SCAN.moveSystem)
            sl(UI.lblArms,"Arms: "..table.concat(G.SCAN.armNames," | "))
            sl(UI.lblParts,("Parts: %d"):format(#G.SCAN.parts))
            sl(UI.lblVMs,("VMs: %d"):format(#G.SCAN.vmList-1))
            sl(UI.lblRems,("Remotes: %d  Shoot: %d"):format(#G.SCAN.remotes,#G.SCAN.shootList-1))
        end) end
    end)

    local CB=TM:AddLeftGroupbox("Combat")
    CB:AddToggle("silentAim",{Text="Silent Aim",Default=G.CFG.silentAim,
        Callback=function(v) G.CFG.silentAim=v; if v then installHooks() end end})
    CB:AddSlider("fov",{Text="FOV",Default=G.CFG.fov,Min=5,Max=2000,Rounding=0,Callback=function(v) G.CFG.fov=v end})
    UI.hitPartDrop=CB:AddDropdown("hitPart",{Text="Hit Part",Values=G.SCAN.parts,Default=G.CFG.hitPart,
        Callback=function(v) G.CFG.hitPart=v end})
    CB:AddToggle("wallCheck",{Text="Wall Check",Default=G.CFG.wallCheck,Callback=function(v) G.CFG.wallCheck=v end})
    CB:AddToggle("teamCheck",{Text="Team Check",Default=G.CFG.teamCheck,Callback=function(v) G.CFG.teamCheck=v end})
    CB:AddSlider("hitChance",{Text="Hit Chance %",Default=G.CFG.hitChance,Min=0,Max=100,Rounding=0,Callback=function(v) G.CFG.hitChance=v end})
    CB:AddToggle("predict",{Text="Prediction",Default=G.CFG.predict,Callback=function(v) G.CFG.predict=v end})
    CB:AddSlider("predictStr",{Text="Predict Str x10",Default=math.floor(G.CFG.predictStr*10),Min=5,Max=30,Rounding=0,Callback=function(v) G.CFG.predictStr=v/10 end})

    local AB=TM:AddRightGroupbox("Aimbot")
    AB:AddToggle("aimbot",{Text="Aimbot",Default=G.CFG.aimbot,Callback=function(v) G.CFG.aimbot=v end})
    AB:AddSlider("smooth",{Text="Smoothness",Default=G.CFG.smooth,Min=1,Max=25,Rounding=0,Callback=function(v) G.CFG.smooth=v end})
    AB:AddDropdown("aimbotMode",{Text="Mode",Values={"camera","humanoid_targetpoint","viewmodel"},Default=G.CFG.aimbotMode,
        Callback=function(v) G.CFG.aimbotMode=v end})
    AB:AddToggle("humanize",{Text="Humanize",Default=G.CFG.humanize,Callback=function(v) G.CFG.humanize=v end})
    AB:AddSlider("jitter",{Text="Jitter",Default=G.CFG.jitter,Min=0,Max=20,Rounding=0,Callback=function(v) G.CFG.jitter=v end})

    local TB=TM:AddRightGroupbox("Triggerbot")
    TB:AddToggle("tbot",{Text="Triggerbot",Default=G.CFG.tbot,
        Callback=function(v) G.CFG.tbot=v; if v then startTriggerbot() end; refreshMob() end})
    TB:AddSlider("trigDelay",{Text="Delay ms",Default=math.floor(G.CFG.trigDelay*1000),Min=0,Max=500,Rounding=0,Callback=function(v) G.CFG.trigDelay=v/1000 end})
    TB:AddSlider("trigRelease",{Text="Release ms",Default=math.floor(G.CFG.trigRelease*1000),Min=0,Max=500,Rounding=0,Callback=function(v) G.CFG.trigRelease=v/1000 end})
    TB:AddDropdown("trigMode",{Text="Fire",Values={"vim","remote","gc"},Default=G.CFG.trigMode,Callback=function(v) G.CFG.trigMode=v end})
    TB:AddToggle("trigKey",{Text="Require key",Default=G.CFG.trigKey,Callback=function(v) G.CFG.trigKey=v end})

    local RB=TM:AddRightGroupbox("Ragebot")
    RB:AddToggle("ragebot",{Text="Ragebot",Default=G.CFG.ragebot,
        Callback=function(v) G.CFG.ragebot=v; if v then startRagebot() end end})
    RB:AddSlider("rageInt",{Text="Interval x100",Default=math.floor(G.CFG.rageInt*100),Min=1,Max=100,Rounding=0,Callback=function(v) G.CFG.rageInt=v/100 end})
    RB:AddSlider("multiShot",{Text="Multi-Shot",Default=G.CFG.multiShot,Min=1,Max=8,Rounding=0,Callback=function(v) G.CFG.multiShot=v end})

    local PB=TM:AddRightGroupbox("Presets")
    for _,name in ipairs({"Rage","Legit","Stealth"}) do
        PB:AddButton({Text=name,Func=function()
            for k,v in pairs(PRESETS[name]) do G.CFG[k]=v end
            pcall(function() Library:Notify({Title="Preset",Description=name,Duration=2}) end)
        end})
    end

    local TS=tab("Scanner")
    if TS then
        local SCB=TS:AddLeftGroupbox("Controls")
        SCB:AddButton({Text="Full Scan",Func=function()
            G.REPORT={}; G.SCAN_STAGE=0
            runScanner(function()
                refreshAllDropdowns()
                if G.REFRESH_REPORT then G.REFRESH_REPORT() end
                if G.REFRESH_EXPLORER then G.REFRESH_EXPLORER() end
                pcall(function()
                    Library:Notify({Title="Scan Done",Description=("Class:%s Parts:%d VMs:%d Remotes:%d AC:%d"):format(
                        G.SCAN.class,#G.SCAN.parts,#G.SCAN.vmList-1,#G.SCAN.remotes,#G.SCAN.antiCheat),Duration=5})
                end)
            end)
        end})
        SCB:AddButton({Text="GC Hook",Func=function()
            task.spawn(function()
                uninstallGC(); G.HOOKS.gcDone=false
                pcall(installGCHook)
                pcall(function() Library:Notify({Title="GC",Description=("Hooked %d"):format(#G.HOOKS.gc),Duration=3}) end)
            end)
        end})
        SCB:AddButton({Text="Re-Hook",Func=function()
            forceReinstall()
            pcall(function() Library:Notify({Title="Re-Hook",Description="Done",Duration=2}) end)
        end})
        SCB:AddButton({Text="Copy Report",Func=function()
            if HAS.setclip then pcall(function() setclipboard(table.concat(G.REPORT,"\n")) end) end
            pcall(function() Library:Notify({Title="Copied",Duration=2}) end)
        end})

        local SRB=TS:AddRightGroupbox("Shoot Remote")
        UI.shootDrop=SRB:AddDropdown("shootRemote",{Text="Remote",Values=G.SCAN.shootList,Default=G.CFG.shootRemote,
            Callback=function(v)
                G.CFG.shootRemote=v; G.SCAN.activeShoot=nil
                if v~="auto" then
                    for _,r in ipairs(G.SCAN.remotes) do if r.name==v then G.SCAN.activeShoot=r.obj; break end end
                else
                    for _,r in ipairs(G.SCAN.remotes) do if r.purpose=="shoot" or r.purpose=="dmg" then G.SCAN.activeShoot=r.obj; break end end
                end
            end})

        local VMB=TS:AddRightGroupbox("Viewmodel")
        UI.vmDrop=VMB:AddDropdown("vm",{Text="Active VM",Values=G.SCAN.vmList,Default="none",
            Callback=function(v) G.SCAN.activeVM=G.SCAN.vmObjects[v] or nil end})

        local EXB=TS:AddLeftGroupbox("Explorer")
        local explorerLbl=EXB:AddLabel("Run Full Scan to populate")
        G.REFRESH_EXPLORER=function()
            local lines=G.SCAN.explorerLines
            local txt=#lines>0 and table.concat(lines,"\n") or "(no rigs found)"
            pcall(function() sl(explorerLbl,txt) end)
        end

        local logLbl=SCB:AddLabel("(run Full Scan)")
        G.REFRESH_REPORT=function()
            local txt=table.concat(G.REPORT,"\n")
            pcall(function() sl(logLbl,txt) end)
        end
    end

    local TMob=tab("Mobile")
    if TMob then
        local MB=TMob:AddLeftGroupbox("Fire Button")
        MB:AddToggle("mobEnabled",{Text="Enabled",Default=G.CFG.mobEnabled,Callback=function(v) G.CFG.mobEnabled=v; refreshMob() end})
        MB:AddSlider("mobSize",{Text="Size",Default=G.CFG.mobSize,Min=50,Max=300,Rounding=0,Callback=function(v) G.CFG.mobSize=v; applyMobStyle() end})
        MB:AddSlider("mobX",{Text="X",Default=G.CFG.mobX,Min=-600,Max=600,Rounding=0,Callback=function(v) G.CFG.mobX=v; applyMobStyle() end})
        MB:AddSlider("mobY",{Text="Y",Default=G.CFG.mobY,Min=-800,Max=800,Rounding=0,Callback=function(v) G.CFG.mobY=v; applyMobStyle() end})
        MB:AddSlider("mobAlpha",{Text="Transparency",Default=math.floor(G.CFG.mobAlpha*100),Min=0,Max=90,Rounding=0,Callback=function(v) G.CFG.mobAlpha=v/100; applyMobStyle() end})
        pcall(function()
            MB:AddInput("mobText",{Text="Label",Default=G.CFG.mobText,Callback=function(v) G.CFG.mobText=v; applyMobStyle() end})
        end)
        local CB2=TMob:AddRightGroupbox("Color RGB")
        CB2:AddSlider("mobR",{Text="R",Default=G.CFG.mobR,Min=0,Max=255,Rounding=0,Callback=function(v) G.CFG.mobR=v; applyMobStyle() end})
        CB2:AddSlider("mobG",{Text="G",Default=G.CFG.mobG,Min=0,Max=255,Rounding=0,Callback=function(v) G.CFG.mobG=v; applyMobStyle() end})
        CB2:AddSlider("mobB",{Text="B",Default=G.CFG.mobB,Min=0,Max=255,Rounding=0,Callback=function(v) G.CFG.mobB=v; applyMobStyle() end})
        CB2:AddButton({Text="Reset Pos",Func=function() G.CFG.mobX=0; G.CFG.mobY=0; applyMobStyle() end})
    end

    local TV=tab("Visuals")
    if TV then
        local EB=TV:AddLeftGroupbox("ESP")
        EB:AddToggle("esp",{Text="ESP",Default=G.CFG.esp,Callback=function(v) G.CFG.esp=v end})
        EB:AddSlider("espDist",{Text="Distance",Default=G.CFG.espDist,Min=50,Max=3000,Rounding=0,Callback=function(v) G.CFG.espDist=v end})
        local IB=TV:AddRightGroupbox("Caps")
        IB:AddLabel(HAS.Drawing and "Drawing: OK" or "Drawing: MISSING")
        IB:AddLabel(HAS.vim and "VIM: OK" or "VIM: MISSING")
        IB:AddLabel(HAS.hookmeta and "hookmetamethod: OK" or "hookmetamethod: MISSING")
        IB:AddLabel(HAS.hookfn and "hookfunction: OK" or "hookfunction: MISSING")
        IB:AddLabel(HAS.getgc and "getgc: OK" or "getgc: MISSING")
        IB:AddLabel(HAS.getnils and "getnilinstances: OK" or "getnilinstances: MISSING")
    end

    local TSet=tab("Settings")
    if TSet then
        local SB2=TSet:AddLeftGroupbox("Script")
        SB2:AddButton({Text="Save Config",Func=function()
            saveConfig()
            pcall(function() Library:Notify({Title="Saved",Description="nono_v10.json",Duration=2}) end)
        end})
        SB2:AddButton({Text="Unload",Func=function()
            _G.NONO_UNLOAD()
            pcall(function() Library:Destroy() end)
        end})
    end

    print("[Nono] UI v10 ready")
end

task.spawn(function()
    print("[Nono] v10 boot")
    startAimbot()
    startESP()
    startTriggerbot()
    startRagebot()

    local ok,err=pcall(buildUI)
    if not ok then warn("[Nono] UI err: "..tostring(err)) end

    runScanner(function()
        print(("[Nono] scan done - %s | parts:%d | vms:%d | remotes:%d | ac:%d"):format(
            G.SCAN.class,#G.SCAN.parts,#G.SCAN.vmList-1,#G.SCAN.remotes,#G.SCAN.antiCheat))
        refreshAllDropdowns()
        if G.REFRESH_REPORT then G.REFRESH_REPORT() end
        if G.REFRESH_EXPLORER then G.REFRESH_EXPLORER() end
    end)

    print("[Nono] v10 ready")
end)