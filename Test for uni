local function startAimbot()
    CONNS[#CONNS+1]=RunService.RenderStepped:Connect(function()
        if not G.CFG.aimbot then return end
        local t=tcache.t
        if not t then return end
        local tpos=safe(function() return t.pos or t.part.Position end)
        if not tpos then return end
        if G.CFG.predict then
            local hrp=safe(function() return t.char:FindFirstChild("HumanoidRootPart") end)
            if hrp then
                local vel=safe(function() return hrp.Velocity end) or Vector3.new()
                local ping=safe(function() return LP:GetNetworkPing() end) or 0.08
                tpos = tpos + vel*(ping+0.05)*G.CFG.predictStr
            end
        end
        pcall(function()
            local cam = getCam()
            if not cam then return end
            local cp = cam.CFrame.Position
            local goal = CFrame.new(cp, tpos)
            local sm = math.max(1, G.CFG.smooth)
            cam.CFrame = sm<=1 and goal or cam.CFrame:Lerp(goal,1/sm)
            if G.CFG.aimbotMode=="humanoid_targetpoint" then
                local hum=LPChar and safe(function() return LPChar:FindFirstChildWhichIsA("Humanoid") end)
                if hum then run(function() hum.TargetPoint=tpos end) end
            end
            if G.CFG.aimbotMode=="viewmodel" and G.SCAN.activeVM then
                local h=safe(function() return G.SCAN.activeVM:FindFirstChild("Handle") end)
                if h then run(function() h.CFrame=CFrame.new(cam.CFrame.Position,tpos) end) end
            end
        end)
        if G.CFG.humanize then
            pcall(function()
                local cam = getCam()
                if not cam then return end
                local j=Vector3.new((math.random()-0.5)*G.CFG.jitter,(math.random()-0.5)*G.CFG.jitter,0)
                cam.CFrame = cam.CFrame*CFrame.new(j)
            end)
        end
    end)
end

