    if not (G.CFG.silentAim or G.CFG.aimbot or G.CFG.tbot or G.CFG.ragebot) then
        tcache.t=nil; return
    end
    local now=tick()
    if now-tcache.ts < tcache.TTL then return end
    tcache.t = findTarget()
    tcache.ts = now
end

-- ============================================================
-- GC HOOK
-- ============================================================
local GC_NAMES = {
    "BulletRayCast","BulletRaycast","RayCastBullet","RaycastBullet",
    "CastBullet","FireBullet","CreateBullet","SpawnBullet","HandleBullet",
    "Hitscan","HitScan","RayCastShoot","FireRay","ShootBullet",
    "ClientShoot","ProcessHit","ShootRay","CalculateBullet",
}

local function patchBulletArgs(args, tpos, n)
    if typeof(args[1])=="CFrame" then
        args[1]=CFrame.lookAt(args[1].Position,tpos); return true end
    if typeof(args[1])=="Vector3" and n>=2 then
        if typeof(args[2])=="Vector3" then args[2]=(tpos-args[1]).Unit; return true end
        if typeof(args[2])=="CFrame"  then args[2]=CFrame.lookAt(args[1],tpos); return true end
    end
    if type(args[1])=="table" then
        local t=args[1]
        local o=t.origin or t.Origin or t.position or t.startPos or t.Start or t.from or t.From
        if o and typeof(o)=="Vector3" then
            local d=(tpos-o).Unit
            if t.direction then t.direction=d end
            if t.dir then t.dir=d end
            if t.Direction then t.Direction=d end
            return true
        end
        local k1,k2
        for k,v in pairs(t) do
            if typeof(v)=="Vector3" then
                if not k1 then k1=k elseif not k2 then k2=k; break end
            end
        end
        if k1 and k2 then t[k2]=(tpos-t[k1]).Unit; return true end
    end
    for i=1,n-1 do
        if typeof(args[i])=="Vector3" and typeof(args[i+1])=="Vector3" then
            args[i+1]=(tpos-args[i]).Unit; return true
        end
    end
    return false
end

local function installGCHook()
    if not (HAS.getgc and HAS.hookfn and HAS.dbginfo) then log("[GC] caps missing"); return end
    if G.HOOKS.gcDone then return end
    log("[GC] starting...")
    local ok,gc = pcall(getgc,true)
    if not ok or type(gc)~="table" then log("[GC] getgc failed"); return end
    G.GC_TOTAL = math.max(1,math.ceil(#gc/500))

    local checked,hooked = 0,0
    for i=1,#gc do
        checked+=1
        if checked%500==0 then G.GC_STAGE=math.floor(checked/500); task.wait() end
        if hooked>=24 then break end
        local v = gc[i]
        if type(v)~="function" then continue end
        local ok2,info = pcall(debug.getinfo,v,"n")
        if not ok2 or type(info)~="table" or not info.name then continue end
        local matched=false
        for _,pat in ipairs(GC_NAMES) do
            if info.name==pat or info.name:find(pat,1,true) then matched=true; break end
        end
        if not matched then continue end

        local orig_ref = {v=nil}
        local function wrapper(...)
            local orig = orig_ref.v
            if not orig then return end
            if inByp() or not G.CFG.silentAim then return orig(...) end
            local t = tcache.t
            if not t then return orig(...) end
            local n = select("#",...)
            if n==0 then return orig(...) end
            local args = table.pack(...)
            local tpos = t.pos or t.part.Position
            if patchBulletArgs(args,tpos,n) then
                byp(true)
                local ok3, r = pcall(orig, table.unpack(args,1,n))
                byp(false)
                if ok3 then return r end
                return orig(...)
            end
            return orig(...)
        end

        local okH,orig = pcall(hookfunction,v,wrapper)
        if okH and orig then
            orig_ref.v = orig
            G.HOOKS.gc[#G.HOOKS.gc+1]={fn=v,orig=orig,wrap=wrapper,name=info.name}
            hooked+=1
            log("[GC-Hook] "..info.name)
        end
    end
    G.HOOKS.gcDone = hooked>0
    G.GC_STAGE = G.GC_TOTAL
    log(("[GC] done - %d hooked"):format(hooked))
end

local function uninstallGC()
    for _,h in ipairs(G.HOOKS.gc) do
        pcall(function() hookfunction(h.fn,h.orig) end)
    end
    G.HOOKS.gc={}; G.HOOKS.gcDone=false
end

-- ============================================================
-- META HOOK (FIXED - no ... inside closures)
-- ============================================================
local function installMetaHook()
    if G.HOOKS.meta then return end
    local RAY_METHODS = {
        Raycast=1, FindPartOnRay=1,
        FindPartOnRayWithIgnoreList=1, FindPartOnRayWithWhitelist=1,
    }
    local _orig = { fn = nil }

    local function wrapper(self, ...)
        local o = _orig.fn
        if not o then return end
        if inByp() or not G.ENABLED then return o(self, ...) end

        local method
        pcall(function() method=getnamecallmethod() end)
        if not method then return o(self, ...) end

        if RAY_METHODS[method] and G.CFG.silentAim then
            if math.random(1,100)>G.CFG.hitChance then return o(self, ...) end
            local t=tcache.t
            if not t then return o(self, ...) end
            local tpos=t.pos or t.part.Position
            local n=select("#", ...)
            local args=table.pack(...)
            local patched=false
            local res

            byp(true)
            pcall(function()
                if method=="Raycast" and n>=2 then
                    local a1 = args[1]
                    if typeof(a1)=="Vector3" then
                        local d=(tpos-a1).Unit*1000
                        if n>=3 then
                            local tail = {}
                            for i=3,n do tail[#tail+1]=args[i] end
                            res = o(self, a1, d, table.unpack(tail))
                        else
                            res = o(self, a1, d)
                        end
                        patched=true
                    end
                elseif n>=1 then
                    local ray = args[1]
                    if typeof(ray)=="Ray" then
                        local nr = Ray.new(ray.Origin,(tpos-ray.Origin).Unit*1000)
                        local tail = {nr}
                        for i=2,n do tail[#tail+1]=args[i] end
                        res = o(self, table.unpack(tail))
                        patched=true
                    end
                end
            end)
            byp(false)
            if patched then return res end
            return o(self, ...)
        end

        if method=="FireServer" and G.CFG.silentAim then
            local sr=getShootRemote()
            if sr and self==sr then
                local t=tcache.t
                if t then
                    local n=select("#", ...)
                    if n>0 then
                        local args=table.pack(...)
                        local tpos=t.pos or t.part.Position
                        if patchBulletArgs(args,tpos,n) then
                            byp(true)
                            local ok3, r = pcall(o, self, table.unpack(args,1,n))
                            byp(false)
                            if ok3 then return r end
                        end
                    end
                end
            end
        end

        return o(self, ...)
    end

    local done=false
    if HAS.hookmeta then
        local ok,o=pcall(hookmetamethod,game,"__namecall",wrapper)
        if ok and o then
            _orig.fn = o
            G.HOOKS.meta={orig=o,via="hookmetamethod"}
            done=true
        end
    end
    if not done and HAS.rawmeta and HAS.setro then
        pcall(function()
            local mt=getrawmetatable(game)
            local o=mt.__namecall
            _orig.fn=o
            setreadonly(mt,false)
            mt.__namecall=function(s,...) return wrapper(s,...) end
            setreadonly(mt,true)
            G.HOOKS.meta={orig=o,via="rawmeta"}; done=true
        end)
    end
    if done then log("[Meta] installed via "..G.HOOKS.meta.via)
    else log("[Meta] FAILED") end
end

local function installHooks()
    if G.HOOKS.installed then return end
    G.HOOKS.installed=true
    task.spawn(function()
        pcall(installGCHook)
        pcall(installMetaHook)
    end)
end

local function forceReinstall()
    uninstallGC()
    G.HOOKS.meta=nil; G.HOOKS.installed=false
    installHooks()
end

