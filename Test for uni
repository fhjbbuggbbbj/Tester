-- ESP
-- ============================================================
local espC={}

local function newDraw(kind,props)
    if not HAS.Drawing then return nil end
    local ok,dr=pcall(function() return Drawing.new(kind) end)
    if not ok then return nil end
    for k,v in pairs(props) do pcall(function() dr[k]=v end) end
    return dr
end

local function makeESP(pl)
    if espC[pl] then return end
    local e={
        box  = newDraw("Square",{Thickness=1,Color=Color3.fromRGB(255,50,50), Filled=false,Visible=false}),
        hp   = newDraw("Square",{Filled=true, Color=Color3.new(0,1,0), Visible=false}),
        name = newDraw("Text",  {Size=13,Center=true,Outline=true,Color=Color3.new(1,1,1),Visible=false}),
        dist = newDraw("Text",  {Size=11,Center=true,Outline=true,Color=Color3.fromRGB(255,220,50),Visible=false}),
        snap = newDraw("Line",  {Thickness=1,Color=Color3.fromRGB(255,130,50),Visible=false}),
    }
    if e.box and e.hp and e.name and e.dist and e.snap then espC[pl]=e end
end

local function killESP(pl)
    local e=espC[pl]; if not e then return end
    for _,d in pairs(e) do pcall(function() d:Remove() end) end
    espC[pl]=nil
end

local function hideESP(pl)
    local e=espC[pl]; if not e then return end
    for _,d in pairs(e) do pcall(function() d.Visible=false end) end
end

local function startESP()
    if not HAS.Drawing then log("[ESP] no Drawing API"); return end
    for _,pl in ipairs(Players:GetPlayers()) do if pl~=LP then makeESP(pl) end end
    Players.PlayerAdded:Connect(function(pl) task.wait(1); if pl~=LP then makeESP(pl) end end)
    Players.PlayerRemoving:Connect(killESP)

    CONNS[#CONNS+1]=RunService.RenderStepped:Connect(function()
        local cam=getCam()
        if not cam then return end
        if not G.CFG.esp then
            for pl in pairs(espC) do hideESP(pl) end; return
        end
        local lpHRP=LPChar and safe(function() return LPChar:FindFirstChild("HumanoidRootPart") end)
        local vp=cam.ViewportSize
        local cx,cy=vp.X/2,vp.Y/2

        for _,pl in ipairs(Players:GetPlayers()) do
            if pl==LP then continue end
            if not espC[pl] then makeESP(pl) end
            local e=espC[pl]; if not e then continue end
            local char = safe(function() return pl.Character end)
            local hrp  = char and safe(function() return char:FindFirstChild("HumanoidRootPart") end)
            local head = char and (safe(function() return char:FindFirstChild("Head") end)
                                or safe(function() return char:FindFirstChildWhichIsA("BasePart") end))
            local hum  = char and safe(function() return char:FindFirstChildWhichIsA("Humanoid") end)
            if not hrp or not head or not hum then hideESP(pl); continue end
            if (safe(function() return hum.Health end) or 0)<=0 then hideESP(pl); continue end
            local dist=lpHRP and (hrp.Position-lpHRP.Position).Magnitude or 9999
            if dist>G.CFG.espDist then hideESP(pl); continue end
            local headSP,vis = cam:WorldToViewportPoint(head.Position+Vector3.new(0,0.6,0))
            local botSP = cam:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
            local isTarget = tcache.t and tcache.t.pl==pl
            if not vis then
                local sc=Vector2.new(cx,cy)
                local dv=Vector2.new(headSP.X,headSP.Y)-sc
                if dv.Magnitude>0 then
                    local edge=sc+dv.Unit*(math.min(cx,cy)*0.85)
                    pcall(function() e.snap.From=sc; e.snap.To=edge; e.snap.Visible=true end)
                end
                pcall(function() e.box.Visible=false; e.hp.Visible=false; e.name.Visible=false; e.dist.Visible=false end)
                continue
            end
            pcall(function() e.snap.Visible=false end)
            local bH=math.max(2,math.abs(headSP.Y-botSP.Y))
            local bW=bH*0.55
            local hp =math.max(0,safe(function() return hum.Health end) or 0)
            local mhp=math.max(1,safe(function() return hum.MaxHealth end) or 100)
            local hr =math.clamp(hp/mhp,0,1)
            pcall(function()
                e.box.Size=Vector2.new(bW,bH)
                e.box.Position=Vector2.new(headSP.X-bW/2,headSP.Y)
                e.box.Color=isTarget and Color3.fromRGB(255,255,0) or Color3.fromRGB(255,50,50)
                e.box.Visible=true
            end)
            pcall(function()
                e.hp.Color=Color3.new(1-hr,hr,0)
                e.hp.Size=Vector2.new(4,bH*hr)
                e.hp.Position=Vector2.new(headSP.X-bW/2-7,headSP.Y+bH*(1-hr))
                e.hp.Visible=true
            end)
            pcall(function()
                e.name.Text=pl.DisplayName.."  ["..math.floor(hp).."]"
                e.name.Position=Vector2.new(headSP.X,headSP.Y-16)
                e.name.Visible=true
            end)
            pcall(function()
                e.dist.Text=("[%.0fm]"):format(dist)
                e.dist.Position=Vector2.new(headSP.X,botSP.Y+3)
                e.dist.Visible=true
            end)
        end
    end)
end

