local function fireVIM()
    if not HAS.vim then return false end
    return pcall(function()
        local v=game:GetService("VirtualInputManager")
        v:SendMouseButtonEvent(0,0,0,true, game,1)
        task.wait(G.CFG.trigRelease)
        v:SendMouseButtonEvent(0,0,0,false,game,1)
    end)
end
local function fireRemote()
    local r=getShootRemote(); if not r then return false end
    local t=tcache.t
    if t then
        local tpos=t.pos or t.part.Position
        local cam=getCam()
        local o = cam and cam.CFrame.Position
        if o and pcall(function() r:FireServer({origin=o,direction=(tpos-o).Unit}) end) then
            return true
        end
    end
    return pcall(function() r:FireServer() end)
end
local function fireGC()
    for _,h in ipairs(G.HOOKS.gc) do
        local nm=h.name or ""
        if nm:find("Fire",1,true) or nm:find("Shoot",1,true) or nm:find("Cast",1,true) then
            if pcall(function() h.orig() end) then return true end
        end
    end
    return false
end
local function doFire()
    local m=G.CFG.trigMode
    if m=="remote" then if not fireRemote() then fireVIM() end
    elseif m=="gc" then if not fireGC() then fireVIM() end
    else fireVIM() end
end

