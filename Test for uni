local function doClassify()
    local oil, def, cust = 0,0,0
    local ok, kids = pcall(function() return workspace:GetChildren() end)
    if not ok then return end
    local checked = 0
    for _, m in ipairs(kids) do
        if checked > 150 then break end
        local cn = safe(function() return m.ClassName end) or ""
        if cn ~= "Model" then continue end
        checked += 1
        local nm = safe(function() return m.Name end) or ""
        if nm:find("Rig") or nm:find("Oil") then oil+=2 end
        local m6,hum,head = 0,false,false
        local ok2,c2 = pcall(function() return m:GetDescendants() end)
        if ok2 then
            for _,d in ipairs(c2) do
                local dcn = safe(function() return d.ClassName end) or ""
                if dcn=="Motor6D"  then m6+=1 end
                if dcn=="Humanoid" then hum=true end
                if dcn=="Part" and (safe(function() return d.Name end) or "")=="Head" then head=true end
            end
        end
        if m6>8  then oil+=2 end
        if m6>=6 and m6<=16 and hum and head then def+=2 end
        if safe(function() return m:FindFirstChild("Animate") ~= nil end) then def+=1 end
        if hum and not head then cust+=1 end
    end
    G.SCAN.class = (oil>def+cust and oil>=4) and "OILRIG"
        or (def>=3) and "DEFAULT_RIG"
        or (cust>=2) and "CUSTOM_RIG" or "UNKNOWN"
    log("[Class] "..G.SCAN.class)
end

