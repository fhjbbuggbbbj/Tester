local function analyzeChar(char, label)
    local info = {
        label=label, parts={}, motors={}, bones={}, scripts={},
        rigType="Unknown", armStyle="Unknown", moveStyle="Unknown", humanoid=nil,
    }
    local desc = safe(function() return char:GetDescendants() end) or {}
    local partSet, motorSet, boneSet = {},{},{}
    local m6count=0; local hasBones=false; local moveFound={}

    for _, d in ipairs(desc) do
        local cn = safe(function() return d.ClassName end) or ""
        local nm = safe(function() return d.Name end) or ""
        if cn=="Part" or cn=="MeshPart" or cn=="UnionOperation" then
            if nm~="" and not partSet[nm] then partSet[nm]=true; info.parts[#info.parts+1]=nm end
        end
        if cn=="Motor6D" then
            m6count+=1
            local p0 = safe(function() return d.Part0 and d.Part0.Name end) or "?"
            local p1 = safe(function() return d.Part1 and d.Part1.Name end) or "?"
            if not motorSet[p1] then motorSet[p1]=true; info.motors[#info.motors+1]=p0.." -> "..p1 end
        end
        if cn=="Bone" then
            hasBones=true
            if nm~="" and not boneSet[nm] then boneSet[nm]=true; info.bones[#info.bones+1]=nm end
        end
        if cn=="LocalScript" or cn=="Script" or cn=="ModuleScript" then
            info.scripts[#info.scripts+1]=nm.." ("..cn..")"
        end
        if cn=="Humanoid" then
            info.humanoid = {
                Health=safe(function() return d.Health end),
                MaxHealth=safe(function() return d.MaxHealth end),
                WalkSpeed=safe(function() return d.WalkSpeed end),
                JumpPower=safe(function() return d.JumpPower end),
                RigType=safe(function() return tostring(d.RigType) end),
                AutoRotate=safe(function() return d.AutoRotate end),
            }
            if info.humanoid.RigType then
                if info.humanoid.RigType:find("R6") then info.rigType="R6"
                elseif info.humanoid.RigType:find("R15") then info.rigType="R15" end
            end
        end
        for indicator, label2 in pairs(MOVE_INDICATORS) do
            if cn==indicator then
                if not moveFound[indicator] then moveFound[indicator]=true; info.moveStyle=label2 end
            end
        end
    end
    if info.rigType=="Unknown" then
        if m6count==6  then info.rigType="R6"
        elseif m6count>=15 and m6count<=17 then info.rigType="R15"
        elseif m6count>17 then info.rigType="Custom/OilRig("..m6count.."M6D)"
        elseif hasBones then info.rigType="Bone-Based" end
    end
    for _, pairNames in ipairs(ARM_PATTERNS) do
        local l,r = pairNames[1],pairNames[2]
        if partSet[l] or partSet[r] then info.armStyle = l.." / "..r; break end
    end
    if info.moveStyle=="Unknown" then
        for _, sn in ipairs(info.scripts) do
            if sn:lower():find("animate") then info.moveStyle="Animate Script (roblox standard)"; break end
        end
    end
    return info
end

local function doScanRigs()
    G.SCAN.rigReport = {}
    local explorerLines = {}
    local partsSeen = {}
    for _,p in ipairs(G.SCAN.parts) do partsSeen[p]=true end

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl==LP then continue end
        local char = safe(function() return pl.Character end)
        if not char then continue end
        local info = analyzeChar(char, pl.Name)
        G.SCAN.rigReport[#G.SCAN.rigReport+1] = info
        for _,p in ipairs(info.parts) do
            if not partsSeen[p] then partsSeen[p]=true; G.SCAN.parts[#G.SCAN.parts+1]=p end
        end
        if info.armStyle~="Unknown" then
            G.SCAN.armNames[#G.SCAN.armNames+1] = pl.Name..": "..info.armStyle
        end
        explorerLines[#explorerLines+1] = "== "..pl.Name.." ["..info.rigType.."]"
        explorerLines[#explorerLines+1] = "   Arms: "..info.armStyle
        explorerLines[#explorerLines+1] = "   Move: "..info.moveStyle
        explorerLines[#explorerLines+1] = "   Parts("..#info.parts.."): "..table.concat(info.parts,", ")
        if #info.motors>0 then explorerLines[#explorerLines+1]="   Motors: "..table.concat(info.motors," | ") end
        if #info.bones>0 then explorerLines[#explorerLines+1]="   Bones: "..table.concat(info.bones,", ") end
        log(("[Rig] %s -> %s | Arms: %s | Move: %s | Parts: %d | Motors: %d | Bones: %d"):format(
            pl.Name, info.rigType, info.armStyle, info.moveStyle, #info.parts, #info.motors, #info.bones))
        task.wait()
    end

    local ok, kids = pcall(function() return workspace:GetChildren() end)
    if ok then
        local n=0
        for _, m in ipairs(kids) do
            if n>60 then break end
            local cn = safe(function() return m.ClassName end) or ""
            if cn~="Model" then continue end
            if not safe(function() return m:FindFirstChildWhichIsA("Humanoid") ~= nil end) then continue end
            local isPl = false
            for _,pl in ipairs(Players:GetPlayers()) do
                if safe(function() return pl.Character==m end) then isPl=true; break end
            end
            if isPl then continue end
            n+=1
            local info = analyzeChar(m, m.Name)
            G.SCAN.rigReport[#G.SCAN.rigReport+1] = info
            for _,p in ipairs(info.parts) do
                if not partsSeen[p] then partsSeen[p]=true; G.SCAN.parts[#G.SCAN.parts+1]=p end
            end
            explorerLines[#explorerLines+1]="== WS:"..m.Name.." ["..info.rigType.."]"
            explorerLines[#explorerLines+1]="   Arms: "..info.armStyle
            explorerLines[#explorerLines+1]="   Move: "..info.moveStyle
            if n%5==0 then task.wait() end
        end
    end
    G.SCAN.explorerLines = explorerLines
    log(("[Rigs] %d analysed | %d parts total"):format(#G.SCAN.rigReport, #G.SCAN.parts))
end

local function doMoveSystem()
    local systems = {}
    if LPChar then
        local desc = safe(function() return LPChar:GetDescendants() end) or {}
        for _,d in ipairs(desc) do
            local cn = safe(function() return d.ClassName end) or ""
            for indicator, label in pairs(MOVE_INDICATORS) do
                if cn==indicator then systems[#systems+1]=label end
            end
            if cn=="LocalScript" then
                local nm = (safe(function() return d.Name end) or ""):lower()
                if nm:find("control") or nm:find("move") or nm:find("animate") then
                    systems[#systems+1]="Script:"..nm
                end
            end
        end
    end
    local ps = safe(function() return LP:FindFirstChild("PlayerScripts") end)
    if ps then
        local cm = safe(function() return ps:FindFirstChild("PlayerModule") end)
        if cm then systems[#systems+1]="PlayerModule (standard ControlModule)" end
    end
    G.SCAN.moveSystem = #systems>0 and table.concat(systems," | ") or "Unknown"
    log("[MoveSystem] "..G.SCAN.moveSystem)
end

local function doScanViewmodels()
    G.SCAN.vmList = {"none"}; G.SCAN.vmObjects = {}; G.SCAN.activeVM = nil

    local function tryAdd(obj, label)
        if not obj then return end
        local path = safe(function() return obj:GetFullName() end) or label
        if G.SCAN.vmObjects[path] then return end
        G.SCAN.vmList[#G.SCAN.vmList+1] = path
        G.SCAN.vmObjects[path] = obj
        if not G.SCAN.activeVM then G.SCAN.activeVM = obj end
        log("[VM] "..path)
    end

    local cam = getCam()
    if cam then
        local camKids = safe(function() return cam:GetChildren() end) or {}
        for _,c in ipairs(camKids) do
            local nm = (safe(function() return c.Name end) or ""):lower()
            local cn = safe(function() return c.ClassName end) or ""
            if cn=="Model" or cn=="Tool" or
               nm:find("view") or nm:find("arm") or nm:find("weapon") or nm:find("gun") then
                tryAdd(c, "Cam."..nm)
            end
        end
    end

    local bp = safe(function() return LP:FindFirstChild("Backpack") end)
    if bp then
        local bKids = safe(function() return bp:GetChildren() end) or {}
        for _,t in ipairs(bKids) do
            if safe(function() return t.ClassName end)=="Tool" then
                tryAdd(t,"Backpack."..(safe(function() return t.Name end) or "?"))
            end
        end
    end

    if LPChar then
        local charDesc = safe(function() return LPChar:GetChildren() end) or {}
        for _,c in ipairs(charDesc) do
            if safe(function() return c.ClassName end)=="Tool" then
                tryAdd(c,"Char."..(safe(function() return c.Name end) or "?"))
            end
        end
    end

    if HAS.getnils then
        local ok2,nils = pcall(getnilinstances)
        if ok2 and type(nils)=="table" then
            for _,obj in ipairs(nils) do
                local cn = safe(function() return obj.ClassName end) or ""
                if cn=="Tool" or cn=="Model" then
                    local nm = (safe(function() return obj.Name end) or ""):lower()
                    if nm:find("weapon") or nm:find("gun") or nm:find("arm") or
                       nm:find("view") or nm:find("rifle") or nm:find("pistol") then
                        tryAdd(obj,"nil."..nm)
                    end
                end
            end
        end
    end
    log(("[VM] %d found"):format(#G.SCAN.vmList-1))
end

local SHOOT_K  = {"shoot","fire","bullet","ray","attack","hitscan","cast","proj","hit","damage","gun","weapon"}
local DAMAGE_K = {"damage","hurt","kill","death","hp","health","takedmg","dealdmg"}
local AC_K     = {"anticheat","anti_cheat","_ac_","guard","sentry","byfron","hyperion","battleye","sanity","verify","report","validate"}
local SKIP_K   = {"package","packagelink","assetservice","gamepass","marketplaceservice"}

local function remPurpose(nm)
    local low = nm:lower()
    for _,k in ipairs(AC_K)     do if low:find(k,1,true) then return "ac"    end end
    for _,k in ipairs(SHOOT_K)  do if low:find(k,1,true) then return "shoot" end end
    for _,k in ipairs(DAMAGE_K) do if low:find(k,1,true) then return "dmg"   end end
    return "other"
end

local function doScanRemotes()
    G.SCAN.remotes = {}; G.SCAN.shootList = {"auto"}; G.SCAN.activeShoot = nil; G.SCAN.antiCheat = {}
    local seen = {}

    local function scanIn(root, tag)
        if not root then return end
        local desc = safe(function() return root:GetDescendants() end) or {}
        local n=0
        for _,d in ipairs(desc) do
            n+=1
            if n%BUDGET==0 then task.wait() end
            local cn = safe(function() return d.ClassName end) or ""
            if cn~="RemoteEvent" and cn~="RemoteFunction" then continue end
            local nm = safe(function() return d.Name end) or ""
            if nm=="" then continue end
            local low = nm:lower()
            local skip=false
            for _,k in ipairs(SKIP_K) do if low:find(k,1,true) then skip=true; break end end
            if skip then continue end
            if seen[nm] then continue end
            seen[nm]=true
            local p = remPurpose(nm)
            local listeners = nil
            if HAS.getconns then
                local ok2,conns = pcall(getconnections, d.OnClientEvent)
                if ok2 then listeners=#conns end
            end
            G.SCAN.remotes[#G.SCAN.remotes+1] = {name=nm, obj=d, purpose=p, tag=tag, listeners=listeners, cn=cn}
            if p=="ac" then
                G.SCAN.antiCheat[#G.SCAN.antiCheat+1] = tag..":"..nm
            elseif p=="shoot" or p=="dmg" then
                G.SCAN.shootList[#G.SCAN.shootList+1] = nm
                if not G.SCAN.activeShoot then G.SCAN.activeShoot=d end
                log(("[Remote] SHOOT: %s (%s)"):format(nm,tag))
            end
        end
    end

    scanIn(RStor, "RS")
    pcall(function() scanIn(LP:FindFirstChild("PlayerScripts"), "PS") end)
    pcall(function() scanIn(LP:FindFirstChild("PlayerGui"), "PG") end)
    scanIn(workspace, "WS")

    local seen2,clean={},{}
    for _,v in ipairs(G.SCAN.antiCheat) do if not seen2[v] then seen2[v]=true; clean[#clean+1]=v end end
    G.SCAN.antiCheat=clean
    log(("[Remotes] total=%d shoot=%d ac=%d"):format(#G.SCAN.remotes,#G.SCAN.shootList-1,#G.SCAN.antiCheat))
end

